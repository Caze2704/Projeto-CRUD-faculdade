<header>
    <h1>Atualização de cadastro de {{infoUser.name}}</h1>
    {{> partials}}
</header>
<main class="formulario">
    <section>
        <form action="/acesso/cadastro/{{infoUser.idcadastros}}/update/save" method="post" id="container" enctype="multipart/form-data">
             <div>
                <label for="name">Nome:</label>
                <input type="text" name="name" id="name" class="input" required maxlength="255" placeholder="Digite seu novo nome" value="{{infoUser.name}}">
            </div>
            <div>
                <label for="age">Idade:</label>
                <input type="number" name="age" id="age" class="input" required min="1", max="120" placeholder="Digite sua nova idade" value="{{infoUser.age}}">
            </div>
            <div>
                <label for="email">Email:</label>
                <input type="email" name="email" id="email" class="input" required placeholder="novo@email" value="{{infoUser.email}}">
            </div>
            <div>
                <label for="photo">Foto (Opcional)</label>
                <input type="file" name="photo" id="photo" class="input" accept="image/*">
            </div>
            <div>
                <input type="submit" value="Atualizar">
            </div>      
        </form>
    </section>
</main>