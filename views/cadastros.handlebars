<header>
    <h1>Cadastros:</h1>
    {{> partials}}
</header>
{{#if message}}
    <div class="alerta">
        <h3>{{message}}</h3>
    </div>
{{/if}}
<div id="container-buscar">
    <input type="search" name="busca" id="busca" placeholder="Digite por um nome">
</div>
<div id="container-cadastros">
    {{#each cadastros}}
        <div>
            <h2>{{this.name}}</h2>
            <a href="/acesso/cadastro/{{idcadastros}}">Ver cadastro</a>
        </div>
    {{/each}}
</div>

<script src="/js/busca.js"defer></script>